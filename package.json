{
  "name": "golos-vnutri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node --experimental-strip-types scripts/build-piper-assets.ts && next build && node --experimental-strip-types scripts/gen-precache.ts",
    "start": "npx http-server out -p 3000 -c-1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && node --experimental-strip-types scripts/check-no-ai.ts",
    "sim": "node --experimental-strip-types engine/simulator/cli.ts",
    "e2e": "playwright test",
    "coverage": "vitest run --coverage --coverage.include='engine/**' --coverage.exclude='engine/**/*.test.ts' --coverage.exclude='engine/simulator/cli.ts'",
    "guard": "node --experimental-strip-types scripts/check-no-ai.ts",
    "voices": "node --experimental-strip-types scripts/build-piper-assets.ts && node --experimental-strip-types scripts/fetch-voices.ts"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "fake-indexeddb": "^6.2.5",
    "onnxruntime-web": "1.22.0",
    "openmoji": "^17.0.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
